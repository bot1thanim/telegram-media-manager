# Required Telegram configuration
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
WEBHOOK_SECRET_TOKEN=
# Legacy compatibility group. It remains required and is used for source/target
# when their dedicated variables below are not supplied.
GROUP_CHAT_ID=
# Optional explicit source/target Forum group IDs for topic synchronization.
SOURCE_GROUP_CHAT_ID=
TARGET_GROUP_CHAT_ID=
GENERAL_TOPIC_THREAD_ID=

# Required PostgreSQL connection: use the Supabase Session Pooler URL for Render.
# Example format only — do not commit a real password.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Required public HTTPS base URL; do not append /webhook.
WEBHOOK_BASE_URL=https://<render-service-name>.onrender.com

# Historical-import credentials are used only by the local one-time command:
# python -m app.sync.topic_importer
# Never configure these values in Render and never commit a session file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_IMPORT_SESSION_PATH=~/.telegram-media-manager-import.session

# Optional application logging level.
LOG_LEVEL=INFO
