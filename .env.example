# Required Telegram configuration
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
WEBHOOK_SECRET_TOKEN=
GROUP_CHAT_ID=
GENERAL_TOPIC_THREAD_ID=

# Required PostgreSQL connection: use the Supabase Session Pooler URL for Render.
# Example format only — do not commit a real password.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Required public HTTPS base URL; do not append /webhook.
WEBHOOK_BASE_URL=https://<render-service-name>.onrender.com

# Optional application logging level.
LOG_LEVEL=INFO
